<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaLogin">

    <ImageView
        android:id="@+id/fundoTelaLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_fundotela2e3" />

    <ImageView
        android:id="@+id/fundoLogin"
        android:layout_width="317dp"
        android:layout_height="346dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_bloco_login" />

    <TextView
        android:id="@+id/tituloEntre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gayathri_bold"
        android:text="Entre"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/fundoLogin"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toTopOf="@+id/fundoLogin" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="55dp"
        android:fontFamily="@font/gayathri"
        android:text="E-mail"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toTopOf="@+id/fundoLogin" />

    <ImageView
        android:id="@+id/iconeUsuario"
        android:layout_width="287dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoLogin"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:srcCompat="@drawable/ic_inputs" />

    <EditText
        android:id="@+id/hintUsuario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        android:ems="10"
        android:hint=""
        android:inputType="textEmailAddress"
        android:maxLength="50"
        app:layout_constraintBottom_toBottomOf="@+id/iconeUsuario"
        app:layout_constraintEnd_toEndOf="@+id/iconeUsuario"
        app:layout_constraintStart_toStartOf="@+id/iconeUsuario"
        app:layout_constraintTop_toTopOf="@+id/iconeUsuario" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:text="Senha"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toBottomOf="@+id/iconeUsuario" />

    <ImageView
        android:id="@+id/iconeSenha"
        android:layout_width="287dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoLogin"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:srcCompat="@drawable/ic_inputs" />

    <EditText
        android:id="@+id/hintSenha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        android:ems="10"
        android:hint=""
        android:inputType="textPassword"
        android:maxLength="10"
        app:layout_constraintBottom_toBottomOf="@+id/iconeSenha"
        app:layout_constraintEnd_toEndOf="@+id/iconeSenha"
        app:layout_constraintStart_toStartOf="@+id/iconeSenha"
        app:layout_constraintTop_toTopOf="@+id/iconeSenha" />

    <Button
        android:id="@+id/botaoParaBiblioteca"
        android:layout_width="277dp"
        android:layout_height="45dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#ffffff"
        android:text="ENTRAR"
        android:textColor="#040303"
        android:textSize="16sp"
        app:cornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoLogin"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin"
        app:layout_constraintTop_toBottomOf="@+id/iconeSenha" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="Não Tem Uma Conta? "
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/fundoLogin"
        app:layout_constraintEnd_toStartOf="@+id/cadastreLogin"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/fundoLogin" />

    <TextView
        android:id="@+id/cadastreLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="Cadastre-se"
        android:textColor="#4763F6"
        app:layout_constraintBottom_toBottomOf="@+id/fundoLogin"
        app:layout_constraintEnd_toEndOf="@+id/fundoLogin"
        app:layout_constraintStart_toEndOf="@+id/textView4" />

</androidx.constraintlayout.widget.ConstraintLayout>