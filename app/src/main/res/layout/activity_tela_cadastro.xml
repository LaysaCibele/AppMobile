<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaCadastro">


    <ImageView
        android:id="@+id/fundoTelaCadastro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_fundotela2e3" />


    <ImageView
        android:id="@+id/fundoCadastro"
        android:layout_width="317dp"
        android:layout_height="426dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_bloco_cadastro" />

    <TextView
        android:id="@+id/tituloCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/gayathri_bold"
        android:text="Criar Conta"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toTopOf="@+id/fundoCadastro" />


    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/gayathri"
        android:text="Usuário"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/tituloCadastro" />

    <ImageView
        android:id="@+id/iconeUsuario"
        android:layout_width="287dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/textView6"
        app:srcCompat="@drawable/ic_inputs" />

    <EditText
        android:id="@+id/hintUsuario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        android:ems="10"
        android:inputType="text"
        android:maxLength="15"
        app:layout_constraintBottom_toBottomOf="@+id/iconeUsuario"
        app:layout_constraintEnd_toEndOf="@+id/iconeUsuario"
        app:layout_constraintStart_toStartOf="@+id/iconeUsuario"
        app:layout_constraintTop_toTopOf="@+id/iconeUsuario" />


    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/gayathri"
        android:text="E-mail"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/iconeUsuario" />

    <ImageView
        android:id="@+id/iconeEmail"
        android:layout_width="287dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/textView8"
        app:srcCompat="@drawable/ic_inputs" />

    <EditText
        android:id="@+id/hintEmail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        android:ems="15"
        android:inputType="textEmailAddress"
        android:maxLength="30"
        app:layout_constraintBottom_toBottomOf="@+id/iconeEmail"
        app:layout_constraintEnd_toEndOf="@+id/iconeEmail"
        app:layout_constraintStart_toStartOf="@+id/iconeEmail"
        app:layout_constraintTop_toTopOf="@+id/iconeEmail" />


    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:text="Senha"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/iconeEmail" />

    <ImageView
        android:id="@+id/iconeSenha"
        android:layout_width="287dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/textView9"
        app:srcCompat="@drawable/ic_inputs" />

    <EditText
        android:id="@+id/hintSenha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@android:color/transparent"
        android:ems="10"
        android:inputType="textPassword"
        android:maxLength="10"
        app:layout_constraintBottom_toBottomOf="@+id/iconeSenha"
        app:layout_constraintEnd_toEndOf="@+id/iconeSenha"
        app:layout_constraintStart_toStartOf="@+id/iconeSenha"
        app:layout_constraintTop_toTopOf="@+id/iconeSenha" />

    <Button
        android:id="@+id/botaoParaLogin"
        android:layout_width="277dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#ffffff"
        android:text="CADASTRE-SE"
        android:textColor="#040303"
        android:textSize="16sp"
        app:cornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro"
        app:layout_constraintTop_toBottomOf="@+id/iconeSenha" />


    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Já Tem Uma Conta? "
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/fundoCadastro"
        app:layout_constraintEnd_toStartOf="@+id/entreLogin"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/fundoCadastro" />

    <TextView
        android:id="@+id/entreLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entre"
        android:textColor="#4763F6"
        app:layout_constraintBottom_toBottomOf="@+id/textView5"
        app:layout_constraintEnd_toEndOf="@+id/fundoCadastro"
        app:layout_constraintStart_toEndOf="@+id/textView5"
        app:layout_constraintTop_toTopOf="@+id/textView5" />

</androidx.constraintlayout.widget.ConstraintLayout>